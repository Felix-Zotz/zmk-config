//
// This keymap is meant to be used with the EurKEY layout.

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Media       1
#define Nav         2
#define NumSym      3
#define Game        4

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        f1s: f1or11 {
            compatible = "zmk,behavior-mod-morph";
            label = "F1OR11";
            bindings = <&kp F1>, <&kp F11>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f2s: f2_or_f12 {
            compatible = "zmk,behavior-mod-morph";
            label = "F2_OR_F12";
            bindings = <&kp F2>, <&kp F12>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sqns: single_quote_no_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "SINGLE_QUOTE_NO_SHIFT";
            bindings = <&kp SQT>, <&kp SQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dqns: double_quote_no_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "DOUBLE_QUOTE_NO_SHIFT";
            bindings = <&kp DQT>, <&kp DQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        eqns: equal_no_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "EQUAL_NO_SHIFT";
            bindings = <&kp EQUAL>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        df: double_function {
            compatible = "zmk,behavior-hold-tap";
            label = "DOUBLE_FUNCTION";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_capsword {
            bindings = <&caps_word>;
            key-positions = <12 21>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <Base>;
        };

        combo_game_toggle {
            bindings = <&tog Game>;
            key-positions = <35 36 37>;
            timeout-ms = <30>;
        };
    };

macros {
        vscode_git_gg: vscode_git_gg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <25>;
            tap-ms = <25>;
            bindings = <&kp LC(LS(G))>
                     , <&kp G>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
            &kp B        &kp L       &kp D          &kp W        &kp Z           &kp SEMI         &kp F        &kp O        &kp U       &kp J        &mo 4
&kp ESCAPE  &hm LMETA N  &hm LALT R  &hm LSHFT T    &hm LCTRL S  &kp G           &kp Y            &hm RCTRL H  &hm RSHFT A  &hm LALT E  &hm RMETA I  &kp SLASH
&kp LPAR    &kp Q        &kp X       &kp M          &kp C        &kp V           &kp K            &kp P        &kp COMMA    &kp DOT     &kp MINUS    &kp RPAR
                                     &kp BACKSPACE  &lt 3 SPACE  &hm RALT ENTER  &lt 1 AMPERSAND  &lt 2 TAB    &kp DELETE
            >;
        };

        Media { // TODO
            label = "Media";
            bindings = <
        &trans         &trans          &trans          &trans           &trans          &trans  &kp C_BRI_UP      &kp C_MUTE      &kp C_VOL_UP     &trans            &trans
&trans  &msc SCRL_LEFT &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &msc SCRL_RIGHT &trans  &hm RCTRL C_PREV  &hm RSHFT C_PP  &hm LALT C_STOP  &hm RMETA C_NEXT  &trans
&trans  &trans         &msc SCRL_DOWN  &mmv MOVE_DOWN  &msc SCRL_UP     &trans          &trans  &kp C_BRI_DEC     &kp C_MUTE      &kp C_VOL_DN     &trans            &trans
                                       &mkp MB2        &mkp MB1        &mkp MB3         &trans  &trans            &trans
            >;
        };

        Nav {
            label = "Nav";
            bindings = <
        &trans  &kp LC(LS(E))  &vscode_git_gg   &kp LC(GRAVE)   &trans    &trans    &kp LC(LEFT)  &trans       &trans        &kp LC(RIGHT)  &trans
&trans  &trans  &trans         &trans           &trans          &trans    &kp CAPS  &kp LEFT      &kp DOWN     &kp UP        &kp RIGHT      &trans
&trans  &trans  &kp LC(B)      &kp LC(J)        &kp LC(LA(B))   &trans    &trans    &kp HOME      &kp LC(END)  &kp LC(HOME)  &kp END        &trans
                               &trans           &trans          &trans    &trans    &trans        &trans
            >;
        };

        NumSym {
            label = "NumSym";
            bindings = <
        &kp F2        &kp F3       &kp F4        &kp F5          &kp F6  &kp F7  &kp F8        &kp F9        &kp F10      &kp F11       &trans
&kp F1  &hm LMETA N0  &hm LALT N1  &hm LSHFT N2  &hm LCTRL N3    &kp N4  &kp N5  &hm RCTRL N6  &hm RSHFT N7  &hm LALT N8  &hm RMETA N9  &kp F12
&trans  &kp GRAVE        &kp APOS  &kp LBKT      &kp LBRC        &trans  &trans  &kp RBRC      &kp RBKT      &kp EQUAL    &kp PLUS      &kp BSLH
                                   &trans        &trans          &trans  &trans  &trans        &trans
            >;
        };

        Game {
            label = "Game";
            bindings = <
            &kp B           &kp L  &kp D          &kp W      &kp Z      &kp SEMI       &kp F    &kp O      &kp U    &kp J      &trans
&kp ESCAPE  &kp N           &kp R  &kp T          &kp S      &kp G      &kp Y          &kp H    &kp A      &kp E    &kp I      &kp SLASH
&kp TAB     &kp LEFT_SHIFT  &kp X  &kp M          &kp C      &kp V      &kp K          &kp P    &kp COMMA  &kp DOT  &kp MINUS  &kp F13
                                   &kp BACKSPACE  &kp SPACE  &kp ENTER  &kp AMPERSAND  &kp F14  &kp DELETE
            >;
        };
    };
};
