#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_de.h"

#define Base        0
#define Media       1
#define Nav         2
#define NumSym      3
#define Game        4

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        f1s: f1or11 {
            compatible = "zmk,behavior-mod-morph";
            label = "F1OR11";
            bindings = <&kp F1>, <&kp F11>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f2s: f2_or_f12 {
            compatible = "zmk,behavior-mod-morph";
            label = "F2_OR_F12";
            bindings = <&kp F2>, <&kp F12>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sqns: single_quote_no_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "SINGLE_QUOTE_NO_SHIFT";
            bindings = <&kp SQT>, <&kp SQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dqns: double_quote_no_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "DOUBLE_QUOTE_NO_SHIFT";
            bindings = <&kp DQT>, <&kp DQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        eqns: equal_no_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "EQUAL_NO_SHIFT";
            bindings = <&kp EQUAL>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        df: double_function {
            compatible = "zmk,behavior-hold-tap";
            label = "DOUBLE_FUNCTION";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_capsword {
            bindings = <&caps_word>;
            key-positions = <12 21>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <Base Base_DE>;
        };

        combo_game_toggle {
            bindings = <&tog Game>;
            key-positions = <35 36 37>;
            timeout-ms = <30>;
        };
    };

    macros {
        cps: copy_shot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R) &kp C>; // TODO
            label = "COPY_SHOT";
        };

        fsh: full_screen_shot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R) &kp F>; // TODO
            label = "FULL_SCREEN_SHOT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
            &kp B        &kp L       &kp D          &kp W        &kp Z        &kp KC_SCLN  &kp F        &kp O        &kp U       &kp J        &mo 4
&kp ESCAPE  &hm LMETA N  &hm LALT R  &hm LSHFT T    &hm LCTRL S   &kp G       &kp Y        &hm RCTRL H  &hm RSHFT A  &hm RALT E  &hm RMETA I  &kp COMMA
&kp LPAR    &kp Q        &kp X       &kp M          &kp C        &kp V        &kp K        &kp P        &kp DOT      &kp MINUS   &kp SLASH    &kp RPAR
                                     &kp BACKSPACE  &lt 3 SPACE  &kp ENTER    &lt 2 //TODO &lt 1 TAB    &kp DELETE
            >;
        };

        Media {
            label = "Media";
            bindings = <
        &trans  &trans  &cps      &trans    &kp C_BRI_UP   &trans    &kp C_MUTE  &kp C_VOL_UP  &kp C_VOL_UP  &trans      &trans
&trans  &trans  &trans  &trans    &trans    &trans         &trans    &kp C_PREV  &kp C_PP      &kp C_STOP    &kp C_NEXT  &trans
&trans  &trans  &trans  &trans    &trans    &kp C_BRI_DEC  &trans    &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_DN  &trans      &trans
                        &mkp MB2  &mkp MB1  &mkp MB3       &trans    &trans      &trans
            >;
        };

        Nav {
            label = "Nav";
            bindings = <
          &trans          &kp LC(RIGHT)   &trans          &kp LS(LC(V))   &kp LC(LEFT)     &trans    &kp END   &kp PG_UP  &kp LC(C)  &trans     &trans
&kp LBRC  &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT &msc SCRL_RIGHT  &kp CAPS  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp RIGHT_BRACE
&kp LBKT  &trans          &msc SCRL_DOWN  &mmv MOVE_DOWN  &msc SCRL_UP    &trans           &trans    &kp HOME  &kp LT     &kp GT     &kp LC(F)  &kp RBKT
                                 &trans   &trans          &trans          &trans           &trans    &trans
            >;
        };

        NumSym {
            label = "NumSym";
            bindings = <
           &kp LG(N1)    &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)    &kp LG(N6)  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp MINUS     &trans
&kp EQUAL  &hm LSHFT N9  &kp N7      &kp N0      &kp N3      &kp F3        &f1s        &kp N1      &kp N2      &kp N4      &hm RSHFT N8  &kp GRAVE
&trans     &kp F9        &kp F7      &kp F10     &kp N5      &kp F5        &kp F6      &kp N6      &f2s        &kp F4      &kp F8        &kp BSLH
                                     &trans      &kp SQT     &trans        &trans      &trans      &trans
            >;
        };

        Game {
            label = "Game";
            bindings = <
            &kp B        &kp L        &kp D          &kp W        &kp Z        &trans       &trans      &trans        &trans       &trans       &trans
&kp ESCAPE  &kp N        &kp R        &kp T          &kp S        &kp G        &trans       &trans      &trans        &trans       &trans       &trans
&kp LPAR    &kp Q        &kp X        &kp M          &kp C        &kp V        &trans       &trans      &trans        &trans       &trans       &trans
                                      &kp BACKSPACE  &kp SPACE    &kp ENTER  &trans       &trans      &trans
            >;
        };
    };
};
