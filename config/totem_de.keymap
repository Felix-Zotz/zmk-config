//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
//
// German QWERTZ variant — use this keymap when the host OS keyboard layout is set to German.
// All keycodes use DE_* macros from keys_de.h so the OS interprets them correctly.

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_de.h"

#define Base        0
#define Media       1
#define Nav         2
#define NumSym      3
#define Game        4
#define Gameplus    5
#define Accent      6

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        fsu: flip_shift_underscore {
            compatible = "zmk,behavior-mod-morph";
            label = "FLIP_SHIFT_UNDERSCORE";
            bindings = <&kp DE_UNDER>, <&kp DE_MINUS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f1s: f1or11 {
            compatible = "zmk,behavior-mod-morph";
            label = "F1OR11";
            bindings = <&kp F1>, <&kp F11>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f2s: f2_or_f12 {
            compatible = "zmk,behavior-mod-morph";
            label = "F2_OR_F12";
            bindings = <&kp F2>, <&kp F12>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        df: double_function {
            compatible = "zmk,behavior-hold-tap";
            label = "DOUBLE_FUNCTION";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };

        hmacute: homerow_mods_accent_acute_de {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_ACCENT_ACUTE_DE";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&acc_acute>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_capsword {
            bindings = <&caps_word>;
            key-positions = <12 21>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        combo_game {
            bindings = <&tog Game>;
            key-positions = <38 39 40>;
            timeout-ms = <30>;
        };
    };

    macros {
        cps: copy_shot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(DE_R) &kp DE_C>;
            label = "COPY_SHOT";
        };

        fsh: full_screen_shot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(DE_R) &kp DE_F>;
            label = "FULL_SCREEN_SHOT";
        };

        acc_acute: accent_acute_de {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp DE_ACUTE &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>;
            label = "ACCENT_ACUTE_DE";
        };

        acc_circ: accent_circumflex_de {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp DE_CARET &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>;
            label = "ACCENT_CIRCUMFLEX_DE";
        };

        game_type: game_type {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ENTER &to 7>;
            label = "GAME_TYPE";
        };

        game_type_exit: game_type_exit {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &to 4>;
            label = "GAME_TYPE_EXIT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
            &kp DE_B        &kp DE_L        &kp DE_D          &kp DE_W        &kp DE_Y        &kp DE_SQT      &kp DE_F       &kp DE_O         &kp DE_U        &kp DE_J        &mo 4
&kp ESCAPE  &hm LSHFT DE_N  &hm LCTRL DE_R  &hm LMETA DE_T    &hm LALT DE_S   &kp DE_G        &kp DE_Z        &hm RALT DE_H  &hm RMETA DE_A   &hm RCTRL DE_E  &hm RSHFT DE_I  &kp DE_COMMA
&kp DE_LPAR &kp DE_Q        &kp DE_X        &kp DE_M          &kp DE_C        &kp DE_V        &kp DE_K        &kp DE_P       &kp DE_DOT       &kp DE_MINUS    &kp DE_FSLH     &kp DE_RPAR
                                          &kp BACKSPACE  &lt 3 SPACE  &kp ENTER    &lt 6 SPACE  &lt 2 TAB   &lt 1 DELETE
            >;                            
        };

        Media {
            label = "Media";
            bindings = <
        &trans          &msc SCRL_DOWN  &fsh            &msc SCRL_UP     &kp C_BRI_UP       &trans  &kp C_MUTE  &kp C_VOL_UP  &kp C_VOL_UP  &trans      &trans
&trans  &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &msc SCRL_RIGHT    &trans  &kp C_PREV  &kp C_PP      &kp C_STOP    &kp C_NEXT  &trans
&trans  &trans          &trans          &mmv MOVE_DOWN  &trans           &kp C_BRI_DEC      &trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_DN  &trans      &trans
                                        &mkp MB2        &mkp MB1         &mkp MB3           &trans  &trans      &trans
            >;
        };

        Nav {
            label = "Nav";
            bindings = <
          &trans  &kp LC(RIGHT)  &trans  &kp LS(LC(DE_V))  &kp LC(LEFT)    &trans    &kp END   &kp PG_UP  &kp LC(DE_C)  &trans     &trans
&kp DE_LBRC  &trans  &trans         &trans  &trans             &trans          &kp CAPS  &kp LEFT  &kp DOWN   &kp UP        &kp RIGHT  &kp DE_RBRC
&kp DE_LBKT  &trans  &kp DEL        &trans  &kp PG_DN          &trans          &trans    &kp HOME  &kp DE_LT  &kp DE_GT     &kp LC(DE_F)  &kp DE_RBKT
                                  &trans  &fsu           &trans          &trans    &trans    &trans
            >;
        };

        NumSym {
            label = "NumSym";
            bindings = <
           &kp LG(DE_N1)    &kp LG(DE_N2)  &kp LG(DE_N3)  &kp LG(DE_N4)  &kp LG(DE_N5)    &kp LG(DE_N6)  &kp LG(DE_N7)  &kp LG(DE_N8)  &kp LG(DE_N9)  &kp DE_MINUS     &trans
&kp DE_EQUAL  &hm LSHFT DE_N9  &kp DE_N7      &kp DE_N0      &kp DE_N3      &kp F3        &f1s        &kp DE_N1      &kp DE_N2      &kp DE_N4      &hm RSHFT DE_N8  &kp DE_GRAVE
&trans     &kp F9        &kp F7      &kp F10     &kp DE_N5      &kp F5        &kp F6      &kp DE_N6      &f2s        &kp F4      &kp F8        &kp DE_BSLH
                                      &trans      &trans      &trans        &trans      &trans      &trans
            >;
        };

        Game {
            label = "Game";
            bindings = <
             &kp TAB    &kp DE_L  &kp DE_D     &kp DE_W      &kp DE_Z              &trans  &trans  &trans  &trans  &trans  &trans
&df TAB ESC  &kp LCTRL  &kp DE_R  &kp DE_T     &kp DE_S      &kp DE_G              &trans  &trans  &trans  &trans  &trans  &trans
&trans       &kp LSHFT  &kp DE_X  &kp DE_M     &kp DE_C      &kp DE_V              &trans  &trans  &trans  &trans  &trans  &trans
                                &kp LALT  &kp SPACE  &lt 5 BACKSPACE    &trans  &trans  &trans
            >;
        };

        Gameplus {
            label = "Gameplus";
            bindings = <
            &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_N4  &kp DE_O     &trans  &trans  &trans  &trans  &trans  &trans
&kp ESC     &kp DE_N   &trans     &trans     &trans     &kp DE_M     &trans  &trans  &trans  &trans  &trans  &trans
&game_type  &kp TAB    &trans     &trans     &trans     &kp DE_K     &trans  &trans  &trans  &trans  &trans  &trans
                                &kp ESCAPE    &trans        &trans    &trans  &trans  &trans
            >;
        };

        Accent {
            label = "Accent";
            bindings = <
        &trans                    &trans  &trans  &trans  &trans    &trans  &acc_acute DE_U    &kp DE_U_UMLAUT  &acc_circ DE_U     &acc_circ DE_O               &trans
&trans  &hmacute LSHFT DE_A      &trans  &trans  &trans  &trans    &trans  &trans             &acc_acute DE_E   &acc_acute DE_I    &hm LSHFT DE_O_UMLAUT        &trans
&trans  &trans                    &trans  &trans  &trans  &trans    &trans  &trans             &trans            &trans             &acc_acute DE_O              &trans
                                  &trans  &trans  &trans    &trans  &trans             &trans
            >;
        };

        GameType {
            bindings = <
                     &trans  &trans  &trans  &trans  &trans                   &trans  &trans  &trans  &trans  &trans  &trans
&game_type_exit ESC  &trans  &trans  &trans  &trans  &trans                   &trans  &trans  &trans  &trans  &trans  &trans
&trans               &trans  &trans  &trans  &trans  &trans                   &trans  &trans  &trans  &trans  &trans  &trans
                                     &trans  &trans  &game_type_exit ENTER    &trans  &trans  &trans
            >;
        };
    };
};
